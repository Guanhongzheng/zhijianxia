{
  "name": "zhijianxia",
  "version": "1.0.0",
  "private": true,
  "description": "智简匣 · 本地离线 AI 优先的局域网工具箱（前端可独立运行，后端可选）",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
