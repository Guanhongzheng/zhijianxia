{
  "name": "zhijianxia",
  "version": "1.1.1",
  "private": true,
  "description": "智简匣 · 本地离线 AI 优先的局域网工具箱（前端可独立运行，后端可选）",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-ort-wasm.mjs",
    "dev": "next dev",
    "build": "node scripts/copy-ort-wasm.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "plugins:build": "node scripts/build-plugins.mjs",
    "plugins:verify": "node scripts/verify-plugins.mjs && node scripts/verify-kernel.mjs",
    "plugins:typecheck": "tsc -p scripts/tsconfig.plugins.json --noEmit",
    "server": "node server/src/index.js",
    "server:init": "node server/src/init-db.js",
    "e2e": "node scripts/zj-e2e.js",
    "e2e:offline": "node scripts/zj-e2e-offline.js",
    "contract": "node scripts/contract-test.mjs",
    "e2e:pollution": "node scripts/zj-e2e-pollution.js",
    "plugin:new": "node scripts/new-plugin.mjs",
    "perf:check": "node perf-regress.mjs",
    "themes:check": "node scripts/theme-tools/theme-check.mjs",
    "themes:verify": "node scripts/theme-tools/theme-verify.mjs",
    "theme:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/theme-search-test.mjs",
    "theme:pack": "node scripts/theme-pack-test.mjs",
    "telemetry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/telemetry-test.mjs",
    "prompt:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prompt-test.mjs",
    "ai:budget": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-budget-test.mjs",
    "test:unit": "npm run theme:search && npm run ai:budget && npm run theme:pack && npm run telemetry && npm run prompt:test",
    "coverage": "node scripts/coverage.mjs",
    "api:docs": "node scripts/gen-openapi.mjs",
    "theme:security": "node scripts/theme-security-test.mjs",
    "theme:ws": "node scripts/theme-ws-test.mjs",
    "theme:verify": "node scripts/verify-theme-plaza.mjs",
    "theme:covers": "node scripts/make-theme-covers.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.152",
    "@huggingface/transformers": "^3.0.0",
    "@langchain/core": "^1.2.20",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.400.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.1.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "c8": "^12.0.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
