{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "..",
    "paths": {
      "@/components/ui/*": ["./scripts/typecheck-stubs/ui/*"],
      "@/lib/utils": ["./scripts/typecheck-stubs/lib/utils.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["../src/plugins/**/*.ts", "../src/plugins/**/*.tsx"]
}
