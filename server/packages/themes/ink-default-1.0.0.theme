{
  "format": "zhijianxia.theme",
  "formatVersion": 1,
  "manifest": {
    "id": "ink-default",
    "name": "素墨",
    "version": "1.0.0",
    "description": "默认主题：靛蓝主色 + 柔和浅灰底，明暗两套配色均衡耐看。",
    "author": "智简匣",
    "preview": "🖋️",
    "tags": [
      "默认",
      "靛蓝",
      "简约"
    ],
    "category": "综合"
  },
  "pack": {
    "id": "ink-default",
    "name": "素墨",
    "version": "1.0.0",
    "description": "默认主题：靛蓝主色 + 柔和浅灰底，明暗两套配色均衡耐看。",
    "author": "智简匣",
    "preview": "🖋️",
    "tags": [
      "默认",
      "靛蓝",
      "简约"
    ],
    "category": "综合",
    "brand": {
      "icon": "🖋️",
      "name": "智简匣",
      "tagline": "本地离线 AI 工具箱"
    },
    "card": {
      "style": "elevated",
      "borderWidth": 1
    },
    "nav": {
      "style": "flat",
      "showIcon": true
    },
    "light": {
      "accent": "#4f6bed",
      "accentSoft": "#eef1fe",
      "card": "#ffffff",
      "bg": "#f6f7f9",
      "fg": "#1c1f24",
      "mutedFg": "#6b7280",
      "border": "#e6e8ec",
      "radius": 16,
      "shadow": 2
    },
    "dark": {
      "accent": "#7d93ff",
      "accentSoft": "#1e2333",
      "card": "#171a20",
      "bg": "#0f1115",
      "fg": "#e8eaed",
      "mutedFg": "#9aa1ad",
      "border": "#262b34",
      "radius": 16,
      "shadow": 2
    },
    "wallpaper": {
      "light": {
        "kind": "gradient",
        "gradient": "linear-gradient(135deg,#eef1fe 0%,#f6f7f9 60%)",
        "veil": 0.9
      },
      "dark": {
        "kind": "gradient",
        "gradient": "linear-gradient(135deg,#141824 0%,#0f1115 60%)",
        "veil": 0.9
      }
    }
  }
}